{
    "name": "dump-data",
    "version": "0.2.0",
    "private": true,
    "description": "Legacy Ringid web frontend - migrated to src/dist layout with config/ for server configuration.",
    "engines": {
        "node": ">=4"
    },
  "scripts": {
    "setup": "npm install && bower install",
    "install:bower": "bower install",
    "start": "npx http-server -p 8080 --cors -c-1",
    "build": "grunt build",
    "migrate": "bash scripts/migrate-content.sh",
    "test": "cd tests && karma start karma.conf.js --single-run"
  },
    "devDependencies": {
        "angular-mocks": "^1.8.3",
        "bower": "^1.8.8",
        "grunt": "^1.6.2",
        "grunt-cli": "^1.4.3",
        "grunt-concat-css": "^0.3.2",
        "grunt-contrib-clean": "^2.0.1",
        "grunt-contrib-concat": "^2.1.0",
        "grunt-contrib-connect": "^5.0.1",
        "grunt-contrib-copy": "^1.0.0",
        "grunt-contrib-cssmin": "^5.0.0",
        "grunt-contrib-uglify": "^5.2.2",
        "karma-jasmine": "^5.1.0",
        "karma-junit-reporter": "^2.0.1"
    }
}
